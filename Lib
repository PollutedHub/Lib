-- Roblox services
local Players = game:GetService("Players") -- To access LocalPlayer and PlayerGui
local UserInputService = game:GetService("UserInputService") -- For input detection
local TweenService = game:GetService("TweenService") -- For smooth property transitions
local ContextActionService = game:GetService("ContextActionService") -- For binding keys to actions

-- GmmUI class/table
local GmmUI = {};
GmmUI.__index = GmmUI;

-- Helper function to create new instances with properties
local function mk(className, props)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		inst[k] = v -- Set the property on the instance
	end
	return inst
end

-- Helper function to create and play tweens
local function tween(obj, ti, props)
	local t = TweenService:Create(obj, ti, props) -- Create tween
	t:Play() -- Play tween immediately
	return t
end

