	Title="GMM", Tab="HOME",
	Size=UDim2.fromOffset(320, 460), Position=UDim2.new(0.02999, 0, 0.02999, 0),
	DisplayOrder=2147483647, -- Ensure UI is on top
	Accent=Color3.fromRGB(138, 3, 3), -- Main accent color
